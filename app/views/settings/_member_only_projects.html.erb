<p>
  <label><%= l(:label_group_id, scope: :member_only_projects) %></label>
  <%= select_tag 'settings[group_id]',
        options_for_select(
          [['', '']] + Group.sorted.map { |g| [g.name, g.id.to_s] },
          @settings['group_id'].to_s
        ) %>
